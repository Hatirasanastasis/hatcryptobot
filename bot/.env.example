# Copy to .env. Only needed for "mode": "live" (paper mode needs nothing).

# Wallet private key the bot trades from.
# Fomo wallet: export it in the Fomo app if it offers that (Settings → wallet/export).
# Otherwise: create a fresh Phantom/Solflare wallet, export its key, and send it SOL from Fomo.
# Base58 string or the [12,34,...] byte array both work.
SOLANA_PRIVATE_KEY=

# Free key from https://portal.jup.ag — required by api.jup.ag
JUPITER_API_KEY=

# Optional: a private RPC (Helius, QuickNode, Triton). The public one rate-limits hard.
RPC_URL=

# YouTube Studio → Create → Go live → Stream → copy the Stream key
YOUTUBE_STREAM_KEY=

# --- Social radar (each source switches on when its key is set) ---
# Reddit: free. reddit.com/prefs/apps → "create app" → type "script". Without keys it uses public JSON (rate-limited).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X / Twitter: paid API (developer.x.com, Basic tier or higher). Watches the accounts in config "social.x_accounts".
X_BEARER_TOKEN=
# CryptoPanic news aggregator: free key at cryptopanic.com/developers/api
CRYPTOPANIC_KEY=
# YouTube live alerts: free key at console.cloud.google.com (YouTube Data API v3). Set channel IDs in config "social.youtube_channels".
YOUTUBE_API_KEY=
